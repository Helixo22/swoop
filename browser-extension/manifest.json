{
  "manifest_version": 3,
  "name": "Swoop",
  "version": "0.1.0",
  "description": "Hand browser downloads over to the Swoop download manager.",
  "permissions": ["downloads", "nativeMessaging", "contextMenus"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "icons": {
    "16": "icons/swoop-16.png",
    "48": "icons/swoop-48.png",
    "128": "icons/swoop-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "swoop@swoop.github.io",
      "strict_min_version": "121.0"
    }
  },
  "key": ""
}
