[Desktop Entry]
Type=Application
Name=Swoop
GenericName=Download Manager
Comment=Download files faster with aria2
Exec=swoop open %u
Icon=io.github.swoop.Swoop
Terminal=false
Categories=Network;FileTransfer;GTK;
Keywords=download;aria2;torrent;magnet;
MimeType=x-scheme-handler/magnet;application/x-bittorrent;
StartupNotify=true
